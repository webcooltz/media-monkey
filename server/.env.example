# Copy to server/.env and fill in. All keys optional — features degrade to stubs without them.

PORT=5000
# Interface to bind (blank = all). Use 127.0.0.1 when behind a reverse proxy.
HOST=
# Set true behind a reverse proxy / tunnel so client IPs + HTTPS are detected correctly.
TRUST_PROXY=false
# Only for split dev setups where the client runs on another origin (e.g. http://localhost:5173).
CORS_ORIGIN=
# Minutes between automatic library rescans (new/removed files). 0 = off.
AUTO_SCAN_MINUTES=15
# SQLite catalog file (defaults to server/data/media.db)
DB_PATH=

# TMDB: powers poster/image lookup AND IMDB-style metadata compare.
# Free key: https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# OMDb: alternative IMDB metadata source. Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# OpenSubtitles: subtitle finder/downloader. Free key: https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
# Account login — required to DOWNLOAD subtitles (search only needs the API key).
# Your opensubtitles.com username + password (used to mint a download token).
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# cleanvid: mute/remove profanity from video. Requires python + `pip install cleanvid` + ffmpeg.
CLEANVID_ENABLED=false
CLEANVID_CMD=cleanvid

# ffmpeg/ffprobe for remux + HLS streaming (set full paths if not on PATH)
FFMPEG_CMD=ffmpeg
FFPROBE_CMD=ffprobe
# Force the h264 encoder, e.g. h264_v4l2m2m (Pi 4) or libx264. Blank = auto-detect.
FFMPEG_HW_ENCODER=

# --- Auth (for public hosting) ---
# Set a password to require login for all media/API access. Leave blank for local, no-auth use.
AUTH_PASSWORD=
# Optional: fixed HMAC secret for sessions. If blank, one is generated + persisted to data/.session-secret.
SESSION_SECRET=
# Set true to always mark the session cookie Secure (also auto-detected behind an HTTPS proxy).
AUTH_COOKIE_SECURE=false
