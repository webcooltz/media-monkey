# Copy to server/.env and fill in. All keys optional — features degrade to stubs without them.

PORT=5000
# SQLite catalog file (defaults to server/data/media.db)
DB_PATH=

# TMDB: powers poster/image lookup AND IMDB-style metadata compare.
# Free key: https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# OMDb: alternative IMDB metadata source. Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# OpenSubtitles: subtitle finder/importer. Free key: https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=

# cleanvid: mute/remove profanity from video. Requires python + `pip install cleanvid` + ffmpeg.
CLEANVID_ENABLED=false
CLEANVID_CMD=cleanvid
